# Base de datos (Supabase, Session Pooler)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# LLM
GROQ_API_KEY="gsk_..."

# Caché (opcional: sin Redis funciona igual, sin caché)
REDIS_URL="redis://127.0.0.1:6379"

# Login con GitHub: crear una OAuth App en https://github.com/settings/developers
# Callback URL de la app: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."
# URL pública del frontend. En desarrollo: http://localhost:5173 (Vite)
APP_URL="http://localhost:5173"
# Firma de la sesión: mínimo 32 caracteres aleatorios (openssl rand -hex 32)
JWT_SECRET="..."
# Usuario de GitHub que puede indexar repos
ADMIN_GITHUB_LOGIN="JefersonGomez"

# Modelos locales (opcional)
# MODEL_THREADS=2
# MODELS_DIR=./models
