generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DocumentChunk {
  id        String                @id @default(uuid())
  content   String
  metadata  Json
  embedding Unsupported("vector")

  @@map("document_chunks")
}

model UserFeedback {
  id        String   @id @default(uuid())
  query     String
  response  String
  rating    Int
  chunkIds  String[]
  createdAt DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}

model RepoIngestion {
  id          String   @id @default(uuid())
  repoUrl     String   @unique
  branch      String
  lastCommit  String
  chunksCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([repoUrl])
}

model User {
  id            String         @id @default(uuid())
  githubId      Int            @unique
  login         String
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  repoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  content        String
  sources        Json?
  rating         Int? // feedback del usuario: 1 = 👎, 2 = 👍
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
