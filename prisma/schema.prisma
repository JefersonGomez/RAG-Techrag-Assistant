// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DocumentChunk {
  id        String                 @id @default(uuid())
  content   String   
  metadata  Json     
  embedding Unsupported("vector(1024)")  
  
  @@map("document_chunks")
}

model UserFeedback {
  id        String   @id @default(uuid())
  query     String
  response  String
  rating    Int
  chunkIds  String[]
  createdAt DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}