// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" // <--- Importante que esté aquí
}

model DocumentChunk {
  id        String   @id @default(uuid())
  content   String   
  metadata  Json     
  embedding Float[]  
  
  @@map("document_chunks")
}